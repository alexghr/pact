FROM aztecprotocol/devbox:3.0

USER root

# Install Gemini CLI
RUN npm install -g @google/gemini-cli

# Entry scripts
COPY entrypoint-common.sh /usr/local/bin/entrypoint-common.sh
COPY entrypoint-gemini.sh /usr/local/bin/entrypoint-gemini.sh
RUN chmod +x /usr/local/bin/entrypoint-common.sh /usr/local/bin/entrypoint-gemini.sh

ENV CI=0

# Git identity for agent commits
RUN git config --system user.name "alexghr-bot" && \
    git config --system user.email "alexghr-bot@users.noreply.github.com"

WORKDIR /workspaces

ENTRYPOINT ["/usr/local/bin/entrypoint-gemini.sh"]
